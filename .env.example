# ────────────────────────────────────────────────────────────────────────────
# Application
# ────────────────────────────────────────────────────────────────────────────
# Base URL — used to build Yoco success/cancel redirect URLs.
# In production: https://shegymz.com   Locally: http://localhost:3000
APP_BASE_URL=https://shegymz.com
NEXT_PUBLIC_APP_URL=https://shegymz.com

# ────────────────────────────────────────────────────────────────────────────
# Database (PostgreSQL)
# ────────────────────────────────────────────────────────────────────────────
# Local dev (direct connection to your local Postgres or the Docker service):
#   postgresql://shegymz:your_password@localhost:5432/shegymzdb
# Docker Compose (container-to-container):
#   postgresql://shegymz:your_password@postgres:5432/shegymzdb
DATABASE_URL=postgresql://shegymz:your_password@postgres:5432/shegymzdb

# PostgreSQL credentials — used by docker-compose for the postgres service
POSTGRES_DB=shegymzdb
POSTGRES_USER=shegymz
POSTGRES_PASSWORD=your_password

# ────────────────────────────────────────────────────────────────────────────
# Metabase
# ────────────────────────────────────────────────────────────────────────────
# Host port for the Metabase UI (default: 3001 → http://localhost:3001) 
METABASE_PORT=3001
# Internal password for Metabase’s own postgres instance (not the app DB)
METABASE_DB_PASSWORD=your_password

# ────────────────────────────────────────────────────────────────────────────
# Authentication (NextAuth)
# ────────────────────────────────────────────────────────────────────────────
# Generate a strong secret: openssl rand -base64 32
NEXTAUTH_SECRET=your_random_secret_here

# Public URL of the app — required by NextAuth for redirects.
# Dev: http://localhost:3000   Prod: https://shegymz.com
NEXTAUTH_URL=https://shegymz.com

# Google OAuth — create credentials at https://console.cloud.google.com
# Authorised redirect URI: ${NEXTAUTH_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# ────────────────────────────────────────────────────────────────────────────
# Paystack Payments
# ────────────────────────────────────────────────────────────────────────────
# Get your keys from https://dashboard.paystack.com/#/settings/developers
# Use sk_test_... for testing, sk_live_... for production.
PAYSTACK_SECRET_KEY=your_paystack_secret_key_here

# Optional recurring billing plan code from the Paystack dashboard.
PAYSTACK_PLAN_CODE=your_paystack_plan_code_here


# ────────────────────────────────────────────────────────────────────────────
# Email (Plunk)
# ────────────────────────────────────────────────────────────────────────────
# Get your API key from https://useplunk.com/dashboard
PLUNK_API_KEY=your_plunk_api_key_here
# Verified sender address in your Plunk dashboard (required by the Plunk API)
PLUNK_FROM_EMAIL=admin@shegymz.com

# Admin email — receives all internal notifications (payments, subscriptions, etc.).
# This is PRIVATE and never shown to clients.
ADMIN_EMAIL=admin@shegymz.com

# Contact email — shown publicly to clients in emails they receive and on the website.
NEXT_PUBLIC_CONTACT_EMAIL=admin@shegymz.com
CONTACT_EMAIL=admin@shegymz.com

PORTAL_CONTACT_EMAIL=admin@shegymz.com


