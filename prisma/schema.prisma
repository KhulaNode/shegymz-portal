generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                          String            @id @default(cuid())
  name                        String?
  email                       String            @unique
  emailVerified               DateTime?
  image                       String?
  passwordHash                String?
  role                        UserRole          @default(CLIENT)
  membershipStatus            MembershipStatus?
  membershipCheckedAt         DateTime?
  membershipProviderReference String?
  trainerProfile              TrainerProfile?   @relation("UserTrainer", fields: [trainerId], references: [id])
  trainerId                   String?           @unique
  accounts                    Account[]
  sessions                    Session[]
  trainingSessions            TrainingSession[]
  createdAt                   DateTime          @default(now())
  updatedAt                   DateTime          @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model SignupChallenge {
  id                  String           @id @default(cuid())
  email               String
  otpHash             String
  membershipStatus    MembershipStatus
  membershipCheckedAt DateTime
  providerReference   String?
  otpSentAt           DateTime?
  expiresAt           DateTime
  consumedAt          DateTime?
  createdAt           DateTime         @default(now())

  @@index([email, createdAt])
  @@index([email, consumedAt, expiresAt])
}

model TrainerProfile {
  id                String                    @id @default(cuid())
  budibaseUserId    String?                   @unique
  displayName       String
  email             String?
  bio               String?
  active            Boolean                   @default(true)
  user              User?                     @relation("UserTrainer")
  scheduleBlocks    TrainerScheduleBlock[]
  availabilitySlots TrainerAvailabilitySlot[]
  trainingSessions  TrainingSession[]
  createdAt         DateTime                  @default(now())
  updatedAt         DateTime                  @updatedAt

  @@index([active])
}

model TrainerScheduleBlock {
  id                  String                    @id @default(cuid())
  trainerProfileId    String
  trainerProfile      TrainerProfile            @relation(fields: [trainerProfileId], references: [id], onDelete: Cascade)
  scheduleType        ScheduleBlockType         @default(RECURRING)
  dayOfWeek           DayOfWeek?
  specificDate        DateTime?                 @db.Date
  startMinutes        Int
  endMinutes          Int
  slotDurationMinutes Int                       @default(60)
  timezone            String                    @default("Africa/Johannesburg")
  effectiveFrom       DateTime?
  effectiveUntil      DateTime?
  active              Boolean                   @default(true)
  generatedSlots      TrainerAvailabilitySlot[]
  createdAt           DateTime                  @default(now())
  updatedAt           DateTime                  @updatedAt

  @@index([trainerProfileId, active])
  @@index([dayOfWeek, active])
  @@index([specificDate, active])
}

model TrainerAvailabilitySlot {
  id               String                 @id @default(cuid())
  trainerProfileId String
  trainerProfile   TrainerProfile         @relation(fields: [trainerProfileId], references: [id], onDelete: Cascade)
  sourceBlockId    String?
  sourceBlock      TrainerScheduleBlock?  @relation(fields: [sourceBlockId], references: [id], onDelete: SetNull)
  startsAt         DateTime
  endsAt           DateTime
  timezone         String                 @default("Africa/Johannesburg")
  status           AvailabilitySlotStatus @default(AVAILABLE)
  trainingSessions TrainingSession[]
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt

  @@unique([trainerProfileId, startsAt, endsAt])
  @@index([trainerProfileId, status, startsAt])
  @@index([sourceBlockId])
}

model TrainingSession {
  id                 String                  @id @default(cuid())
  memberUserId       String
  memberUser         User                    @relation(fields: [memberUserId], references: [id], onDelete: Restrict)
  trainerProfileId   String
  trainerProfile     TrainerProfile          @relation(fields: [trainerProfileId], references: [id], onDelete: Restrict)
  availabilitySlotId String
  availabilitySlot   TrainerAvailabilitySlot @relation(fields: [availabilitySlotId], references: [id], onDelete: Restrict)
  startsAt           DateTime
  endsAt             DateTime
  status             TrainingSessionStatus   @default(SCHEDULED)
  memberNotes        String?
  attendance         SessionAttendance?
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt

  @@index([memberUserId, status, startsAt])
  @@index([trainerProfileId, status, startsAt])
}

model SessionAttendance {
  id                     String            @id @default(cuid())
  trainingSessionId      String            @unique
  trainingSession        TrainingSession   @relation(fields: [trainingSessionId], references: [id], onDelete: Cascade)
  outcome                AttendanceOutcome
  markedByIdentifier     String
  notes                  String?
  markedAt               DateTime          @default(now())
  createdAt              DateTime          @default(now())
  updatedAt              DateTime          @updatedAt
}

enum UserRole {
  CLIENT
  ADMIN
  TRAINER
}

enum MembershipStatus {
  ACTIVE
  INACTIVE
}

enum DayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

enum ScheduleBlockType {
  RECURRING
  ONE_OFF
}

enum AvailabilitySlotStatus {
  AVAILABLE
  BOOKED
  BLOCKED
}

enum TrainingSessionStatus {
  SCHEDULED
  CANCELLED_BY_MEMBER
  CANCELLED_BY_ADMIN
}

enum AttendanceOutcome {
  ATTENDED
  MISSED
  CANCELLED
}
